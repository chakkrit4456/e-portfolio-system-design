DATABASE_URL=postgres://bpcd:bpcd_pass@localhost:5432/bpcd_eportfolio
# สุ่มค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# กุญแจเข้ารหัส API Key ของ AI (แยกจาก SESSION_SECRET เพื่อให้เปลี่ยน SESSION_SECRET ได้โดยไม่ต้องใส่ API Key ใหม่)
# เว้นว่างได้ — ถ้าไม่ตั้งจะใช้กุญแจที่ derive จาก SESSION_SECRET
AI_ENC_KEY=
PORT=3000
# รหัสผ่านเริ่มต้นของผู้ใช้ตัวอย่าง (ใช้ตอน seed ครั้งแรกเท่านั้น)
SEED_PASSWORD=changeme123
# ตั้งเป็น true เมื่อรันหลัง HTTPS reverse proxy จริง (production) — เพื่อบังคับ cookie ส่งผ่าน HTTPS เท่านั้น
COOKIE_SECURE=false
# สแกนความปลอดภัย (เมนู ความปลอดภัย ของผู้ดูแลระบบ) — เว้นว่างได้ถ้าไม่ใช้
SNYK_TOKEN=
SNYK_ORG=
# ถ้าเครือข่ายองค์กรดักตรวจ HTTPS (Snyk ขึ้น x509 certificate signed by unknown authority) ให้ชี้ไปที่ไฟล์ CA ขององค์กร
# NODE_EXTRA_CA_CERTS=/path/to/org-ca.pem
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
