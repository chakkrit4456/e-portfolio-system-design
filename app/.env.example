DATABASE_URL=postgres://bpcd:bpcd_pass@localhost:5432/bpcd_eportfolio
# สุ่มค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
# รหัสผ่านเริ่มต้นของผู้ใช้ตัวอย่าง (ใช้ตอน seed ครั้งแรกเท่านั้น)
SEED_PASSWORD=changeme123
# ตั้งเป็น true เมื่อรันหลัง HTTPS reverse proxy จริง (production) — เพื่อบังคับ cookie ส่งผ่าน HTTPS เท่านั้น
COOKIE_SECURE=false
